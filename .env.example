# Local development. In Vercel production, use the Neon-provided POSTGRES_URL
# or set DATABASE_URL explicitly.
DATABASE_URL=postgresql://...

# Admin panel credentials — set strong unique values in Vercel Environment Variables.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me-to-a-long-random-password
ADMIN_SESSION_SECRET=change-me-to-a-long-random-secret
